{
  "name": "immo-lagecheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lage-Check für Immobilienmakler: Adresse suchen, Grundstück einzeichnen, Umgebung prüfen.",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:colors": "node scripts/check-colors.mjs",
    "format": "prettier --write .",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,vue,js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,json,md,html,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*": [
      "node scripts/check-colors.mjs"
    ]
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.6",
    "@turf/turf": "^7.4.0",
    "leaflet": "^1.9.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
